# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
# ...except the GUI bundle, which is committed so `uv run jarvis-gui` works without Node
# (CI rebuilds it and fails when it's stale — see .github/workflows/test.yml).
!apps/gui/web/dist/
wheels/
*.egg-info

# Virtual environments
.venv

.env
memory/
personal-context/context/

# Import sources (large export files)
imports/

# Personal data
backup/
data/context/
data/conversations/
data/outcomes/
data/pattern-cards/
data/prompt-history/
data/rag/
data/.cli_history
data/.gui_token

# Local config overrides (keep default.yaml, ignore local overrides)
config/local.yaml
config/*.local.yaml

# IDE/Editor settings
.idea/
.vscode/
*.swp
*.swo
*~
# Claude Code Desktop creates a worktree per session here
.claude/worktrees/

# OS files
.DS_Store
Thumbs.db

# Test/coverage artifacts
.coverage
htmlcov/
.pytest_cache/
.mutmut-cache
mutants/
docs/engineering/mutation-results-raw.txt
tests/golden/results/

# Personal voice profile
packages/agents/writer/prompts/voice-profile.md
# Personal voice profile — real writing samples, employer, self-description.
# Ships as voice-profile.md.example; copy it and fill it in locally.
packages/agents/_shared/prompts/voice-profile.md

# Heartbeat runtime data (journals, plans)
data/heartbeat/

# Brainstorms and reflections (personal thinking, not code)
data/brainstorms/

# Individual skills (personal content, framework code is tracked)
packages/skills/*
!packages/skills/*.py
# Shared practices symlink (external spec repo, machine-specific path)
packages/agents/_shared/prompts/engineering-practices.md
